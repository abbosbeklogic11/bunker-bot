# --- Debug & Logging ---
DEBUG=False
LOG_LEVEL=INFO

# --- Webhook (optional; leave blank for long-polling) ---
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080
