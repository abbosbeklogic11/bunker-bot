# --- Telegram Bot ---
BOT_TOKEN=8892450674:AAGTeeOb_jNEvcWirwJ2pHdSkc_kmxXLWLE

# --- Database (PostgreSQL via asyncpg) ---
DATABASE_URL=postgresql+asyncpg://bunker_user:bunker_pass@localhost:5432/bunker_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Admin Telegram User IDs (comma-separated, no spaces) ---
